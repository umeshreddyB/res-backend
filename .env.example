ENV=dev
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/restaurant
SECRET_KEY=change-this-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
TIMEZONE=Asia/Kolkata
ADVANCE_PERCENT=50
RESERVATION_MINUTES=90
HOLD_MINUTES=15
RESERVATION_DEPOSIT_ENABLED=false
# Razorpay: leave key id empty to use mock mode (no real network call) in dev
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=dev-secret
RAZORPAY_WEBHOOK_SECRET=
PETPOOJA_ENABLED=false
