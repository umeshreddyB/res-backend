# ==============================================================================
# Restaurant Backend Configuration
# Copy this file to .env and adjust variables for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Environment
# ------------------------------------------------------------------------------
# Options: dev, prod. In prod, strict checks enforce strong secrets, no default passwords, and non-empty CORS.
ENV=dev

# Secret key used for signing JWT access tokens (minimum 32 characters in production)
SECRET_KEY=change-this-to-a-long-random-string

# Access token expiration in minutes (default: 720 minutes = 12 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated list of allowed CORS origins for the frontend application
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Restaurant timezone (default: Asia/Kolkata, UTC+05:30)
TIMEZONE=Asia/Kolkata

# Application log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# PostgreSQL connection URL (psycopg 3 driver). In dev, SQLite can also be used: sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/restaurant

# Optional: Dedicated PostgreSQL test database URL used by pytest for row-lock concurrency tests
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/restaurant_test

# ------------------------------------------------------------------------------
# Initial Admin Credentials (seeded on first startup if no admin exists)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# ------------------------------------------------------------------------------
# Reservation, Holds & Dining Settings
# ------------------------------------------------------------------------------
# Default advance payment percentage if partial payment is enabled (0 - 100)
ADVANCE_PERCENT=50

# Default reservation dining duration in minutes
RESERVATION_MINUTES=90

# Time in minutes a dine-in table is held while awaiting customer online payment
HOLD_MINUTES=15

# Enable or disable requiring advance payment/deposit for pure table reservations
RESERVATION_DEPOSIT_ENABLED=false

# Inactivity timeout in minutes after which unpaid pending orders are cancelled
ABANDONED_ORDER_TIMEOUT_MINUTES=30

# ------------------------------------------------------------------------------
# Rate Limiting (In-Memory sliding window per client IP)
# ------------------------------------------------------------------------------
# Max login attempts allowed within the window
RATE_LIMIT_LOGIN=10

# Max registration attempts allowed within the window
RATE_LIMIT_REGISTER=5

# Rate limit sliding window duration in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# Security & Reverse Proxy
# ------------------------------------------------------------------------------
# Comma-separated list of trusted proxy IPs/CIDRs (e.g. Nginx, Cloudflare, load balancers).
# Only requests originating from these IPs will have their X-Forwarded-For header trusted.
TRUSTED_PROXIES=127.0.0.1,::1

# ------------------------------------------------------------------------------
# Media & Menu Images
# ------------------------------------------------------------------------------
# Local directory where uploaded menu item images are saved and served from
MEDIA_DIR=media

# Maximum allowed image upload size in megabytes
MAX_UPLOAD_SIZE_MB=5

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway
# Leave RAZORPAY_KEY_ID empty to run in mock mode (simulated orders, no real network calls)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=dev-secret
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# PetPooja POS Integration
# ------------------------------------------------------------------------------
# Set to true once official API credentials and payload documentation are configured
PETPOOJA_ENABLED=false
PETPOOJA_BASE_URL=https://api.petpooja.com
PETPOOJA_APP_KEY=
PETPOOJA_APP_SECRET=
PETPOOJA_ACCESS_TOKEN=
PETPOOJA_REST_ID=
